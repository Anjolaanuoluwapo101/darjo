{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "figma": {
            "type": "remote",
            "url": "https://mcp.figma.com/mcp",
            "enabled": true,
            "oauth": {
                "redirectUri": "http://127.0.0.1:19876/callback"
            }
        },
        "paypal-sandbox": {
            "type": "remote",
            "url": "https://mcp.sandbox.paypal.com/sse",
            "enabled": true,
            "headers": {
                "Authorization": "Bearer {env:PAYPAL_SANDBOX_ACCESS_TOKEN}"
            }
        }
    }
}